### Booking: hello (anonymous)
POST {{function_url}}/api_booking/hello
Content-Type: application/json

{
  "data": {}
}

### Booking: availabilityList (anonymous for now)
POST {{function_url}}/api_booking/availabilityList
Content-Type: application/json

{
  "data": {
    "fromDate": "2026-05-01",
    "toDate": "2026-05-03"
  }
}

### Booking: availabilitySeed (anonymous playground helper)
POST {{function_url}}/api_booking/availabilitySeed
Content-Type: application/json

{
  "data": {
    "fromDate": "2026-05-01",
    "days": 7,
    "capacity": 10
  }
}

### Booking: stayRequestCreate (anonymous playground helper)
POST {{function_url}}/api_booking/stayRequestCreate
Content-Type: application/json

{
  "data": {
    "uid": "demo-user",
    "petName": "Milo",
    "startDate": "2026-05-01",
    "endDate": "2026-05-03"
  }
}

### Booking: staysList
POST {{function_url}}/api_booking/staysList
Content-Type: application/json

{
  "data": {
    "limit": 20
  }
}

### Create a review
POST {{function_url}}/api_booking/reviewCreate
Content-Type: application/json

{
  "data": {
    "stayId": "1339cd3b-cea2-4f01-a1aa-7530f35adee4",
    "uid": "demo-user",
    "rating": 1,
    "comment": "My pet had a great service"
  }
}

### List reviews for a stay
POST {{function_url}}/api_booking/reviewsList
Content-Type: application/json

{
  "data": {
    "stayId": "1"
  }
}

### Booking: reviewsListAll
POST {{function_url}}/api_booking/reviewsListAll
Content-Type: application/json

{
  "data": {
    "limit": 20
  }
}

### Booking: reviewSeed (anonymous playground helper)
POST {{function_url}}/api_booking/reviewSeed
Content-Type: application/json

{
  "data": {
    "numberOfStays": 5,
    "reviewsPerStay": 4
  }
}

### Booking: reviewsFiltered - top rated(4 or above)
POST {{function_url}}/api_booking/reviewsFiltered
Content-Type: application/json

{
  "data": {
    "minRating": 4,
    "maxRating": 5,
    "limit": 20
  }
}

### Booking: reviewsFiltered - low rated(2 or below)
POST {{function_url}}/api_booking/reviewsFiltered
Content-Type: application/json

{
  "data": {
    "minRating": 1,
    "maxRating": 2,
    "limit": 20
  }
}

### Booking: reviewsFiltered - All reviews (no filter, defualts)
POST {{function_url}}/api_booking/reviewsFiltered
Content-Type: application/json

{
  "data": {}
}

### Booking: staysByRating — highest rated stays
POST {{function_url}}/api_booking/staysByRating
Content-Type: application/json

{
  "data": {
    "order": "desc",
    "limit": 10
  }
}

### Booking: staysByRating — lowest rated stays
POST {{function_url}}/api_booking/staysByRating
Content-Type: application/json

{
  "data": {
    "order": "asc",
   "limit": 10
  }
}

### Booking: stayCancel
POST {{function_url}}/api_booking/stayCancel
Content-Type: application/json

{
  "data": {
    "stayId": "SOME STAY ID"
  }
}

